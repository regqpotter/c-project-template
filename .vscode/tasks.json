{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "make all",
            "type": "shell",
            "command": "C:\\msys64\\usr\\bin\\bash.exe",
            "args": [
                "-lc",
                "cd \"$1\" && make all",
                "_",
                "${workspaceFolder}"
            ],
            "options": {
                "env": {
                    "MSYSTEM": "UCRT64"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
